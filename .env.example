# VentureMind AI environment variables (frontend + backend)
# Copy to .env.local for frontend and configure backend vars in Render.

# Frontend (Vercel)
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/analyze
ANALYZE_API_KEY=

# Backend (Render Web Service)
GROQ_API_KEY=your_groq_api_key
SERPER_API_KEY=your_serper_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1400
SERPER_RESULTS=5
SEARCH_LANGUAGE=en
SEARCH_COUNTRY=us
MAX_REASONING_LOOPS=2
LLM_RETRIES=3
TOOL_RETRIES=3
CONFIDENCE_THRESHOLD=76
REQUEST_TIMEOUT_SECONDS=45
FRONTEND_URL=https://venture-mind-ai-eight.vercel.app
ENVIRONMENT=production
