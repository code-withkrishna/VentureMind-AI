# VentureMind AI — environment variables
# Copy this file to api.env and fill in your keys

# Required: Groq LLM API key (free at https://console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# Required: Serper search API key (free at https://serper.dev)
SERPER_API_KEY=your_serper_key_here

# Optional: override the default model
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: tune agent behaviour
# GROQ_MAX_TOKENS=1400
# MAX_REASONING_LOOPS=2
# CONFIDENCE_THRESHOLD=76
